# Supabase Configuration
# Get these from your Supabase project dashboard
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Canonical site URL used for metadataBase, canonical/OG tags, JSON-LD and
# the Plausible data-domain (see src/lib/site-url.ts, ticket #118).
# Set it in Vercel for Preview, Production AND Development, then redeploy.
# Falls back to VERCEL_URL on Vercel, http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.vercel.app

# Optional: VAPID keys for push notifications (generate with web-push)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# GitHub Actions repository secret used by .github/workflows/gdpr-automation.yml (GDPR sweep):
# Lives in GitHub -> Settings -> Secrets and variables -> Actions, NOT in this file.
# SUPABASE_CRON_SECRET       — must match the edge function's CRON_SECRET env var (set via `supabase secrets set`)

# member-gdpr-sweep deployment prerequisites (set on Supabase, not here):
# Deploy with JWT verification disabled: supabase functions deploy member-gdpr-sweep --no-verify-jwt
# Set the CRON_SECRET env var: supabase secrets set CRON_SECRET=... --project-ref <ref>
# NOTE: we deliberately do NOT store the Supabase service role key as a GitHub secret (exfiltration risk).

# Playwright defaults to a local, read-only target. Remote targets and writes
# require all relevant safeguards to be explicitly enabled.
# E2E_BASE_URL=http://localhost:3000
# E2E_ALLOW_REMOTE=false
# E2E_TARGET_ENV=test
# E2E_ALLOW_WRITES=false
# E2E_SUPABASE_URL=http://127.0.0.1:54321
# E2E_SUPABASE_SERVICE_ROLE_KEY=copy_the_local_service_role_key_from_supabase_status
# Optional override for the PRD seed-account password (global-setup generates
# a per-run password otherwise). Never commit a real value here.
# E2E_PRD_PASSWORD=
